<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${param.title != null ? param.title : 'Apex Driving School'}</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Clean Minimalist UI Stylesheet -->
    <link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet">
</head>
<body>

<!-- Minimalist Navigation Bar with Role-Based Access Control -->
<nav class="navbar navbar-expand-lg navbar-clean sticky-top">
    <div class="container">
        <a class="navbar-brand-custom" href="${pageContext.request.contextPath}/${sessionScope.userRole eq 'STUDENT' or sessionScope.userRole eq 'INSTRUCTOR' ? 'lessons' : 'dashboard'}">
            <i class="bi bi-car-front-fill fs-5"></i>
            <span>Apex Driving School</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto ms-lg-3 gap-1">
                <!-- 1. Executive Dashboard (ADMIN ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard">
                            <i class="bi bi-grid-1x2 me-1"></i> Dashboard
                        </a>
                    </li>
                </c:if>

                <!-- 2. Students Directory (ADMIN ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'students' ? 'active' : ''}" href="${pageContext.request.contextPath}/students">
                            <i class="bi bi-people me-1"></i> Students
                        </a>
                    </li>
                </c:if>

                <!-- 3. Lessons & Scheduling (ALL ROLES - Contextual label) -->
                <li class="nav-item">
                    <a class="nav-link-custom ${param.activeTab eq 'lessons' ? 'active' : ''}" href="${pageContext.request.contextPath}/lessons">
                        <i class="bi bi-calendar2-check me-1"></i>
                        <c:choose>
                            <c:when test="${sessionScope.userRole eq 'STUDENT'}">My Lessons</c:when>
                            <c:when test="${sessionScope.userRole eq 'INSTRUCTOR'}">Teaching Schedule</c:when>
                            <c:otherwise>Lessons &amp; Queue</c:otherwise>
                        </c:choose>
                    </a>
                </li>

                <!-- 4. Instructors Roster (ADMIN & INSTRUCTOR ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN' or sessionScope.userRole eq 'INSTRUCTOR'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'instructors' ? 'active' : ''}" href="${pageContext.request.contextPath}/instructors">
                            <i class="bi bi-person-badge me-1"></i> Instructors
                        </a>
                    </li>
                </c:if>

                <!-- 5. Vehicle Fleet (ADMIN & INSTRUCTOR ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN' or sessionScope.userRole eq 'INSTRUCTOR'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'vehicles' ? 'active' : ''}" href="${pageContext.request.contextPath}/vehicles">
                            <i class="bi bi-truck me-1"></i> Vehicles
                        </a>
                    </li>
                </c:if>

                <!-- 6. Payments & Billing (ADMIN & STUDENT ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN' or sessionScope.userRole eq 'STUDENT'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'payments' ? 'active' : ''}" href="${pageContext.request.contextPath}/payments">
                            <i class="bi bi-credit-card me-1"></i>
                            <c:choose>
                                <c:when test="${sessionScope.userRole eq 'STUDENT'}">My Payments</c:when>
                                <c:otherwise>Payments</c:otherwise>
                            </c:choose>
                        </a>
                    </li>
                </c:if>

                <!-- 7. Feedback & Reviews (ADMIN & STUDENT ONLY) -->
                <c:if test="${empty sessionScope.userRole or sessionScope.userRole eq 'ADMIN' or sessionScope.userRole eq 'STUDENT'}">
                    <li class="nav-item">
                        <a class="nav-link-custom ${param.activeTab eq 'feedback' ? 'active' : ''}" href="${pageContext.request.contextPath}/feedback">
                            <i class="bi bi-chat-square-text me-1"></i> Feedback
                        </a>
                    </li>
                </c:if>
            </ul>

            <!-- Right-Side Role Switcher & User Profile Dropdown -->
            <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px; font-size: 0.82rem;">
                        <i class="bi ${sessionScope.userRole eq 'STUDENT' ? 'bi-person-fill text-primary' : (sessionScope.userRole eq 'INSTRUCTOR' ? 'bi-person-badge-fill text-info' : 'bi-shield-lock-fill text-danger')}"></i>
                        <span class="fw-semibold">${not empty sessionScope.userName ? sessionScope.userName : 'Admin (Sajan P.)'}</span>
                        <span class="badge ${sessionScope.userRole eq 'STUDENT' ? 'bg-primary' : (sessionScope.userRole eq 'INSTRUCTOR' ? 'bg-info text-dark' : 'bg-danger')} ms-1" style="font-size: 0.65rem;">
                            ${not empty sessionScope.userRole ? sessionScope.userRole : 'ADMIN'}
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="font-size: 0.85rem; border-radius: 10px;">
                        <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.05em;">Switch Portal (Live Viva Demo)</h6></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 ${sessionScope.userRole eq 'ADMIN' ? 'active fw-bold' : ''}" href="${pageContext.request.contextPath}/switch-role?role=ADMIN&redirect=/dashboard">
                                <i class="bi bi-shield-lock-fill text-danger"></i>
                                <div>
                                    <div>Administrator Portal</div>
                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Full access (All 7 tabs &amp; CRUD)</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 ${sessionScope.userRole eq 'STUDENT' ? 'active fw-bold' : ''}" href="${pageContext.request.contextPath}/switch-role?role=STUDENT&redirect=/lessons">
                                <i class="bi bi-person-fill text-primary"></i>
                                <div>
                                    <div>Customer / Student Portal</div>
                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Only Lessons, Payments &amp; Reviews</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 ${sessionScope.userRole eq 'INSTRUCTOR' ? 'active fw-bold' : ''}" href="${pageContext.request.contextPath}/switch-role?role=INSTRUCTOR&redirect=/lessons">
                                <i class="bi bi-person-badge-fill text-info"></i>
                                <div>
                                    <div>Instructor Staff Portal</div>
                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Training schedule, fleet, &amp; roster</small>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/logout">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- Page Content Container -->
<div class="container py-4 flex-grow-1">
    <c:if test="${not empty error}">
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            <div><c:out value="${error}"/></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </c:if>
    <c:if test="${param.success eq 'true'}">
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>Saved successfully! File updated in <code>data/</code> folder.</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </c:if>
    <c:if test="${not empty param.processed}">
        <div class="alert alert-info alert-dismissible fade show d-flex align-items-center mb-3" role="alert">
            <i class="bi bi-arrow-right-circle-fill me-2"></i>
            <div>FIFO Queue: Processed request <strong><c:out value="${param.processed}"/></strong> &rarr; Confirmed!</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </c:if>
